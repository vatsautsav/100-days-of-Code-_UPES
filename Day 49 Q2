// Print initials of a name with the surname displayed in full.

/*
Sample Test Cases:
Input 1:
John David Doe
Output 1:
J.D. Doe

*/



#include <stdio.h>

int main() {
    char name[100];
    int i;

    fgets(name, sizeof(name), stdin);

    for (i = 0; name[i] != '\0'; i++) {
        if (i == 0 && name[i] != ' ')
            printf("%c.", name[i]);

        if (name[i] == ' ' && name[i + 1] != ' ') {
            if (name[i + 1] != '\0')
                printf("%c.", name[i + 1]);
        }
    }

    // Find the last word and print it in full
    i = 0;
    while (name[i] != '\0')
        i++;

    i--;

    while (i >= 0 && name[i] != ' ')
        i--;

    i++;

    printf(" ");

    while (name[i] != '\0' && name[i] != '\n') {
        printf("%c", name[i]);
        i++;
    }

    return 0;
}
