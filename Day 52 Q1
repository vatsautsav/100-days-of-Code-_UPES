#include <stdio.h>

int main() {
    int arr[] = {1, 2, 8, 10, 11, 12, 19};
    int n = 7;
    int x = 5;

    int low = 0, high = n - 1;
    int ans = -1;

    while (low <= high) {
        int mid = (low + high) / 2;

        if (arr[mid] >= x) {
            ans = mid;       // Possible answer
            high = mid - 1;  // Search for first occurrence on left
        } else {
            low = mid + 1;
        }
    }

    printf("%d", ans);

    return 0;
}
